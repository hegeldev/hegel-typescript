{
  "name": "@hegeldev/hegel",
  "version": "0.4.6",
  "description": "Property-based testing for TypeScript",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hegeldev/hegel-typescript.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "browser": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./generators": {
      "types": "./dist/generators/index.d.ts",
      "default": "./dist/generators/index.js"
    },
    "./libhegel.wasm": "./dist/browser/libhegel-wasm32-unknown-unknown.wasm"
  },
  "files": [
    "dist",
    "BROWSER.md"
  ],
  "prettier": {
    "printWidth": 100
  },
  "scripts": {
    "build": "tsc && node scripts/fetch-libhegel.mjs --wasm dist/browser",
    "test": "vitest run --coverage",
    "lint": "prettier --check . && eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "docs": "typedoc",
    "prepack": "npm run build",
    "test:browser": "node scripts/test-browser-package.mjs",
    "test:packaging": "node --test scripts/packaging.test.mjs",
    "typecheck:portable": "tsc -p tsconfig.portable.json"
  },
  "keywords": [
    "hegel",
    "property-based-testing",
    "hypothesis"
  ],
  "author": "David R. MacIver <david.maciver@antithesis.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "0.28.2",
    "eslint": "^10.0.2",
    "playwright": "1.63.0",
    "prettier": "^3.8.1",
    "rollup": "4.63.1",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "8.0.9",
    "vitest": "^4.0.18",
    "webpack": "5.110.3"
  },
  "dependencies": {
    "koffi": "^3.0.2"
  },
  "optionalDependencies": {
    "@hegeldev/hegel-darwin-arm64": "0.4.6",
    "@hegeldev/hegel-linux-arm64": "0.4.6",
    "@hegeldev/hegel-linux-x64": "0.4.6",
    "@hegeldev/hegel-win32-arm64": "0.4.6",
    "@hegeldev/hegel-win32-x64": "0.4.6"
  }
}
